# =============================================================
# Fichier .env.example — template des variables d'environnement
# Copier en .env et renseigner les valeurs réelles (ne jamais
# committer le fichier .env dans le dépôt).
# =============================================================

# Serveur Express
PORT=3000

# PostgreSQL
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=consultant_db
PG_USER=
PG_PASSWORD=

# SMTP (envoi d'e-mails via nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Nom du site (utilisé dans les emails)
SITE_NAME=

# Adresse de destination des messages de contact
SITE_OWNER_EMAIL=

# Clé API (protection des routes d'administration)
API_KEY=

# CORS — liste d'origines autorisées, séparées par des virgules
CORS_ORIGIN=http://localhost:3000
